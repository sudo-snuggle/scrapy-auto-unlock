#!/bin/bash
DEVICE="192.168.1.##:5555"

# 1. Close any frozen/dead scrcpy windows
killall scrcpy 2>/dev/null

# 2. Check if ADB is connected over Wi-Fi
if ! adb devices | grep -q "$DEVICE"; then
    echo "Connecting to ADB over Wi-Fi..."
    adb connect $DEVICE
    sleep 0.5
fi

# 3. If Wi-Fi connect failed (e.g. phone was rebooted), check for USB connection
if ! adb devices | grep -q "$DEVICE"; then
    USB_DEV=$(adb devices | grep -v "List" | grep -v "$DEVICE" | grep "device" | awk '{print $1}')
    if [ -n "$USB_DEV" ]; then
        echo "Phone reboot detected. Enabling TCP/IP over USB..."
        adb -s $USB_DEV tcpip 5555
        sleep 2
        adb connect $DEVICE
        sleep 0.5
    fi
fi

# 4. Wake screen and swipe up
adb -s $DEVICE shell input keyevent 224
sleep 0.1
adb -s $DEVICE shell input swipe 500 1500 500 500

# 5. Type PIN
sleep 0.1
adb -s $DEVICE shell input text ####

# 6. Launch scrcpy session with screen off
exec /usr/bin/scrcpy -s $DEVICE --turn-screen-off "$@"
